(cram
 (applies_to commandline)
 (deps untyped/zanuda.exe)
 (package zanuda))

(rule
 (deps %{project_root}/src/main.exe)
 (target zanuda.exe)
 (package zanuda)
 (action
  (copy %{deps} %{target})))

(cram
